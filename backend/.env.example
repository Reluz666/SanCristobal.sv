APP_NAME="Ventas POS Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16+ (producción y desarrollo)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ventas_pos_pro
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSLMODE=prefer
DB_CHARSET=utf8

# Redis 7+ (cache, sesiones y colas)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=ventas_pos_pro

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Laravel Sanctum
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SANCTUM_TOKEN_PREFIX=vpp_
# Minutos de vigencia del token Bearer (720 = 12 horas)
SANCTUM_EXPIRATION=720

# Auditoría (retención mínima de 5 años para información fiscal)
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_CLEAN_AFTER_DAYS=1825
ACTIVITYLOG_BUFFER_ENABLED=false

# Facturación electrónica SUNAT
# SUNAT_MODE: simulate | auto | live
# SUNAT_ENVIRONMENT solo acepta: beta | production
SUNAT_MODE=simulate
SUNAT_ENVIRONMENT=beta
SUNAT_RUC=
SUNAT_LEGAL_NAME=
SUNAT_SOL_RUC=
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
SUNAT_CERTIFICATE_PATH=sunat/demo-cert.pem
SUNAT_CERTIFICATE_PASSWORD=
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=
SUNAT_API_BASE_URL=
SUNAT_TIMEOUT=8

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notificaciones@ventaspospro.pe"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
